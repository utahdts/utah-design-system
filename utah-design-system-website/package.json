{
  "name": "utah-design-system-website",
  "private": true,
  "version": "5.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development-local",
    "build": "vite build --mode production-website",
    "buildw": "vite build --watch --mode production-website",
    "eslint": "npx eslint",
    "eslintw": "npx eslint-watch -w",
    "preview": "vite preview",
    "publishLibrary": "npm publish --access public",
    "test": "vitest",
    "testw": "vitest",
    "testc": "vitest run --coverage",
    "tsc": "tsc",
    "tscw": "tsc --watch --skipLibCheck",
    "watch": "vite watch",
    "testOnce": "vitest run"
  },
  "dependencies": {
    "@utahdts/utah-design-system": "5.2.0",
    "@utahdts/utah-design-system-header": "5.2.0",
    "date-fns": "4.4.0",
    "js-beautify": "2.0.3",
    "lodash-es": "4.18.1",
    "prop-types": "15.8.1",
    "react": "^19.2.8",
    "react-colorful": "5.8.0",
    "react-router-dom": "^7.18.2",
    "tinycolor2": "1.6.0",
    "use-immer": "0.11.0"
  },
  "devDependencies": {
    "@types/js-beautify": "1.14.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/tinycolor2": "1.4.6",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "sass": "^1.102.0",
    "vite": "^8.2.1",
    "vite-plugin-eslint": "1.8.1",
    "vite-plugin-mkcert": "^2.1.0",
    "vitest": "^4.1.10"
  },
  "eslint.workingDirectories": [
    "./src",
    "./test"
  ]
}
